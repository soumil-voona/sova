# Decimal cases for translation tests. Values are chosen so floating point
# (Python, JavaScript) gives the same digits as Sova's exact decimals, and
# no decimal result is whole (JavaScript prints 5.0 as 5).
fact price("tea", 2.50)
fact price("cake", 3.75)
fact price("bread", 4)

rule total(a, b, t):
    price(a, x)
    AND price(b, y)
    AND t = x + y

rule cheap(item):
    price(item, p)
    AND p < 3.8

rule calc(name, v):
    name = "times"
    AND v = -0.5 * 3
    OR name = "quarter"
    AND v = 1 / 4.0
    OR name = "third"
    AND v = 1 / 3.0
    OR name = "left over"
    AND v = 7.5 % 2
    OR name = "mixed"
    AND v = (3 + 0.25) * 2 - 0.25

rule halves(n, h):
    h = n / 2

rule share(total, people, each):
    each = total / people
