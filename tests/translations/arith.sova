# Arithmetic cases for translation tests.
fact factorial(0, 1)
rule factorial(n, f):
    n > 0
    AND m = n - 1
    AND factorial(m, g)
    AND f = n * g

fact steps(1, 0)
rule steps(n, s):
    n > 1
    AND n % 2 == 0
    AND m = n / 2
    AND steps(m, t)
    AND s = t + 1
rule steps(n, s):
    n > 1
    AND n % 2 == 1
    AND m = 3 * n + 1
    AND steps(m, t)
    AND s = t + 1

fact gcd(a, 0, a)
rule gcd(a, b, g):
    b > 0
    AND r = a % b
    AND gcd(b, r, g)

rule divs(a, b, q, r):
    q = a / b
    AND r = a % b

rule calc(a, b, c, d, e):
    a = 2 + 3 * 4
    AND b = (2 + 3) * 4
    AND c = 10 - 4 - 3
    AND d = 2 * -3
    AND e = -(2 + 3)

rule triple(x, y):
    x * 3 = y

fact score("Ana", 7)
fact score("Ben", 3)
fact score("Cy", 9)
rule close(x, y):
    score(x, a)
    AND score(y, b)
    AND x != y
    AND a - b <= 4
    AND a + b > 9

rule labelled(x, unit):
    score(x, s)
    AND unit = "points"
    AND s * 2 >= 14
