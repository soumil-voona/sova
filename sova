#!/usr/bin/env bash
#sova
#
# Usage: ./sova [--brief] [--trace] FILE
#        ./sova -i [--brief] [--trace] [FILE]
#        ./sova --pseudocode TARGET FILE
#        ./sova --python | --functional | --javascript TARGET FILE
#        ./sova --compare TARGET FILE
#        ./sova --exercises | --start N | --check FILE
#        ./sova --tokens | --ast | --kb FILE
#
#   (no flag)  answer each ask, with a proof for every answer and an
#              explanation for every FALSE
#   --brief    answer without proofs or explanations
#   --trace    first show the search step by step: each goal Sova tries,
#              what it matches, dead ends, and going back to try other
#              options (stops after 300 goals; set SOVA_TRACE_LIMIT)
#   -i         interactive prompt: load FILE (optional), then ask questions
#              and add facts or rules
#   --pseudocode TARGET
#              show how TARGET could be written in a conventional language;
#              TARGET is a predicate name (grandparent) or a call
#              (ancestor("Ada", who)) whose known values shape the functions
#   --python TARGET
#              the same, as a runnable Python program
#   --functional TARGET
#              the same, as Python written with list comprehensions
#   --javascript TARGET  (or --js)
#              the same, as a runnable JavaScript program (Node.js)
#   --compare TARGET
#              TARGET written three ways (logic, imperative, functional)
#              with a table of how the ideas map between them
#   --exercises
#              list the exercises and how far your copies have got
#   --start N  copy exercise N into my-exercises/ to work on
#   --check FILE
#              run FILE's expect lines and explain any that fail
#   --tokens   show lexer tokens
#   --ast      show the parsed AST
#   --kb       show the knowledge base

# Find the real install folder, following symlinks, so sova works when it
# is linked onto PATH (for example ~/.local/bin/sova -> ~/.local/share/sova/sova).
sova_resolve_dir() {
    local source="${BASH_SOURCE[0]}" dir
    while [[ -L "$source" ]]; do
        dir="$(cd -P "$(dirname "$source")" && pwd)"
        source="$(readlink "$source")"
        [[ "$source" == /* ]] || source="$dir/$source"
    done
    cd -P "$(dirname "$source")" && pwd
}
SOVA_DIR="$(sova_resolve_dir)"

# How to name this command in hints: "sova" when it was found on PATH
# (an installed copy), "./sova" when run from a clone.
case ":$PATH:" in
    *":$(dirname "$0"):"*) SOVA_CMD="sova" ;;
    *)                     SOVA_CMD="./sova" ;;
esac
export SOVA_CMD

# shellcheck source=src/color.sh
source "$SOVA_DIR/src/color.sh"
# shellcheck source=src/lexer.sh
source "$SOVA_DIR/src/lexer.sh"
# shellcheck source=src/check_reqs.sh
source "$SOVA_DIR/src/check_reqs.sh"
# shellcheck source=src/parser.sh
source "$SOVA_DIR/src/parser.sh"
# shellcheck source=src/knowledge_base.sh
source "$SOVA_DIR/src/knowledge_base.sh"
# shellcheck source=src/inference.sh
source "$SOVA_DIR/src/inference.sh"
# shellcheck source=src/explain.sh
source "$SOVA_DIR/src/explain.sh"
# shellcheck source=src/trace.sh
source "$SOVA_DIR/src/trace.sh"
# shellcheck source=src/builtins.sh
source "$SOVA_DIR/src/builtins.sh"
# shellcheck source=src/pseudocode.sh
source "$SOVA_DIR/src/pseudocode.sh"
# shellcheck source=src/compare.sh
source "$SOVA_DIR/src/compare.sh"
# shellcheck source=src/check.sh
source "$SOVA_DIR/src/check.sh"
# shellcheck source=src/exercises.sh
source "$SOVA_DIR/src/exercises.sh"
# shellcheck source=src/repl.sh
source "$SOVA_DIR/src/repl.sh"

usage() {
    sed -n '4,10p' "${BASH_SOURCE[0]}" | sed 's/^# //' >&2
    exit 1
}

mode="run"

while [[ "$1" == -* ]]; do
    case "$1" in
        --tokens)           mode="tokens" ;;
        --ast)              mode="ast" ;;
        --kb)               mode="kb" ;;
        --brief)            SOVA_BRIEF=1 ;;
        --trace)            SOVA_TRACE=1 ;;
        -i | --interactive) mode="repl" ;;
        --check)            mode="check" ;;
        --exercises)        mode="exercises" ;;
        --start)
            mode="start"
            start_number="$2"
            [[ -n "$start_number" ]] || usage
            shift
            ;;
        --pseudocode | --python | --functional | --javascript | --js | --compare)
            mode="translate"
            case "$1" in
                --pseudocode) translate_lang="pseudo" ;;
                --python)     translate_lang="python" ;;
                --functional) translate_lang="functional" ;;
                --compare)    translate_lang="compare" ;;
                *)            translate_lang="javascript" ;;
            esac
            translate_target="$2"
            [[ -n "$translate_target" ]] || usage
            shift
            ;;
        *)                  echo "${E_RED}Unknown option:${E_RESET} $1" >&2; usage ;;
    esac
    shift
done

file_path="$1"

if [[ "$mode" == "exercises" ]]; then
    list_exercises
    exit $?
fi
if [[ "$mode" == "start" ]]; then
    start_exercise "$start_number"
    exit $?
fi

if [[ "$mode" == "repl" ]]; then
    if [[ -n "$file_path" ]]; then
        check_reqs "$file_path" || exit 1
    fi
    repl "$file_path"
    exit $?
fi

check_reqs "$file_path" || exit 1

if [[ "$mode" == "tokens" ]]; then
    tokenize_file "$file_path"
    exit $?
fi

parse_program "$file_path" || exit 1

case "$mode" in
    check)
        check_file "$file_path"
        exit $?
        ;;
    ast)
        print_ast
        ;;
    kb)
        kb_load
        kb_print_arity_warnings
        kb_print
        ;;
    translate)
        kb_load
        kb_print_arity_warnings
        if [[ "$translate_lang" == "compare" ]]; then
            compare_paradigms "$translate_target"
        else
            translate_to "$translate_lang" "$translate_target"
        fi
        ;;
    run)
        kb_load
        kb_print_arity_warnings
        kb_run_queries
        ;;
esac
