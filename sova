
#!/usr/bin/env bash
#
# Usage: ./sova [--tokens | --ast | --kb] FILE

source ./src/lexer.sh
source ./src/check_reqs.sh
source ./src/parser.sh
source ./src/knowledge_base.sh

mode="run"

case "$1" in
    --tokens) mode="tokens"; shift ;;
    --ast)    mode="ast"; shift ;;
    --kb)     mode="kb"; shift ;;
esac

file_path="$1"

check_reqs "$file_path" || exit 1

if [[ "$mode" == "tokens" ]]; then
    tokenize_file "$file_path"
    exit $?
fi

parse_program "$file_path" || exit 1

case "$mode" in
    ast)
        print_ast
        ;;
    kb)
        kb_load
        kb_print
        ;;
    run)
        kb_load
        kb_run_queries
        ;;
esac
