#!/usr/bin/env bash
#sova
#
# Usage: ./sova [--brief] FILE
#        ./sova -i [--brief] [FILE]
#        ./sova --tokens | --ast | --kb FILE
#
#   (no flag)  answer each ask, with a proof for every answer and an
#              explanation for every FALSE
#   --brief    answer without proofs or explanations
#   -i         interactive prompt: load FILE (optional), then ask questions
#              and add facts or rules
#   --tokens   show lexer tokens
#   --ast      show the parsed AST
#   --kb       show the knowledge base

SOVA_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=src/lexer.sh
source "$SOVA_DIR/src/lexer.sh"
# shellcheck source=src/check_reqs.sh
source "$SOVA_DIR/src/check_reqs.sh"
# shellcheck source=src/parser.sh
source "$SOVA_DIR/src/parser.sh"
# shellcheck source=src/knowledge_base.sh
source "$SOVA_DIR/src/knowledge_base.sh"
# shellcheck source=src/inference.sh
source "$SOVA_DIR/src/inference.sh"
# shellcheck source=src/repl.sh
source "$SOVA_DIR/src/repl.sh"

usage() {
    sed -n '4,6p' "${BASH_SOURCE[0]}" | sed 's/^# //' >&2
    exit 1
}

mode="run"

while [[ "$1" == -* ]]; do
    case "$1" in
        --tokens)           mode="tokens" ;;
        --ast)              mode="ast" ;;
        --kb)               mode="kb" ;;
        --brief)            SOVA_BRIEF=1 ;;
        -i | --interactive) mode="repl" ;;
        *)                  echo "Unknown option: $1" >&2; usage ;;
    esac
    shift
done

file_path="$1"

if [[ "$mode" == "repl" ]]; then
    if [[ -n "$file_path" ]]; then
        check_reqs "$file_path" || exit 1
    fi
    repl "$file_path"
    exit $?
fi

check_reqs "$file_path" || exit 1

if [[ "$mode" == "tokens" ]]; then
    tokenize_file "$file_path"
    exit $?
fi

parse_program "$file_path" || exit 1

case "$mode" in
    ast)
        print_ast
        ;;
    kb)
        kb_load
        kb_print_arity_warnings
        kb_print
        ;;
    run)
        kb_load
        kb_print_arity_warnings
        kb_run_queries
        ;;
esac
