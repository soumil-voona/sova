ask factorial(10, f)
  f = 3628800
    factorial(10, 3628800)  [rule factorial]
      10 > 0  [comparison]
      9 = 10 - 1  [calculation]
      factorial(9, 362880)  [rule factorial]
        9 > 0  [comparison]
        8 = 9 - 1  [calculation]
        factorial(8, 40320)  [rule factorial]
          8 > 0  [comparison]
          7 = 8 - 1  [calculation]
          factorial(7, 5040)  [rule factorial]
            7 > 0  [comparison]
            6 = 7 - 1  [calculation]
            factorial(6, 720)  [rule factorial]
              6 > 0  [comparison]
              5 = 6 - 1  [calculation]
              factorial(5, 120)  [rule factorial]
                5 > 0  [comparison]
                4 = 5 - 1  [calculation]
                factorial(4, 24)  [rule factorial]
                  4 > 0  [comparison]
                  3 = 4 - 1  [calculation]
                  factorial(3, 6)  [rule factorial]
                    3 > 0  [comparison]
                    2 = 3 - 1  [calculation]
                    factorial(2, 2)  [rule factorial]
                      2 > 0  [comparison]
                      1 = 2 - 1  [calculation]
                      factorial(1, 1)  [rule factorial]
                        1 > 0  [comparison]
                        0 = 1 - 1  [calculation]
                        factorial(0, 1)  [fact]
                        1 = 1 * 1  [calculation]
                      2 = 2 * 1  [calculation]
                    6 = 3 * 2  [calculation]
                  24 = 4 * 6  [calculation]
                120 = 5 * 24  [calculation]
              720 = 6 * 120  [calculation]
            5040 = 7 * 720  [calculation]
          40320 = 8 * 5040  [calculation]
        362880 = 9 * 40320  [calculation]
      3628800 = 10 * 362880  [calculation]
  TRUE

