ask gcd(48, 18, g)
  g = 6
    gcd(48, 18, 6)  [rule gcd]
      18 > 0  [comparison]
      12 = 48 % 18  [calculation]
      gcd(18, 12, 6)  [rule gcd]
        12 > 0  [comparison]
        6 = 18 % 12  [calculation]
        gcd(12, 6, 6)  [rule gcd]
          6 > 0  [comparison]
          0 = 12 % 6  [calculation]
          gcd(6, 0, 6)  [fact]
  TRUE

ask steps(6, s)
  s = 8
    steps(6, 8)  [rule steps, clause 1]
      6 > 1  [comparison]
      6 % 2 == 0  [comparison]
      3 = 6 / 2  [calculation]
      steps(3, 7)  [rule steps, clause 2]
