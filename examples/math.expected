          steps(5, 5)  [rule steps, clause 2]
            5 > 1  [comparison]
            5 % 2 == 1  [comparison]
            16 = 3 * 5 + 1  [calculation]
            steps(16, 4)  [rule steps, clause 1]
              16 > 1  [comparison]
              16 % 2 == 0  [comparison]
              8 = 16 / 2  [calculation]
              steps(8, 3)  [rule steps, clause 1]
                8 > 1  [comparison]
                8 % 2 == 0  [comparison]
                4 = 8 / 2  [calculation]
                steps(4, 2)  [rule steps, clause 1]
                  4 > 1  [comparison]
                  4 % 2 == 0  [comparison]
                  2 = 4 / 2  [calculation]
                  steps(2, 1)  [rule steps, clause 1]
                    2 > 1  [comparison]
                    2 % 2 == 0  [comparison]
                    1 = 2 / 2  [calculation]
                    steps(1, 0)  [fact]
                    1 = 0 + 1  [calculation]
                  2 = 1 + 1  [calculation]
                3 = 2 + 1  [calculation]
              4 = 3 + 1  [calculation]
            5 = 4 + 1  [calculation]
          6 = 5 + 1  [calculation]
        7 = 6 + 1  [calculation]
      8 = 7 + 1  [calculation]
  TRUE

