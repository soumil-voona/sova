ask length([5, 6, 7], n)
  n = 3
    length([5, 6, 7], 3)  [rule length]
      length([6, 7], 2)  [rule length]
        length([7], 1)  [rule length]
          length([], 0)  [fact]
          1 = 0 + 1  [calculation]
        2 = 1 + 1  [calculation]
      3 = 2 + 1  [calculation]
  TRUE

ask append([1, 2], [3], all)
  all = [1, 2, 3]
    append([1, 2], [3], [1, 2, 3])  [rule append]
      append([2], [3], [2, 3])  [rule append]
        append([], [3], [3])  [fact]
  TRUE

ask append(front, back, [1, 2])
  front = [], back = [1, 2]
    append([], [1, 2], [1, 2])  [fact]
  front = [1], back = [2]
    append([1], [2], [1, 2])  [rule append]
      append([], [2], [2])  [fact]
  front = [1, 2], back = []
    append([1, 2], [], [1, 2])  [rule append]
      append([2], [], [2])  [rule append]
        append([], [], [])  [fact]
  TRUE

ask member(x, ["a", "b"])
  x = "a"
    member("a", ["a", "b"])  [fact]
  x = "b"
    member("b", ["a", "b"])  [rule member]
      member("b", ["b"])  [fact]
  TRUE

ask sum([1, 2, 3, 4], s)
  s = 10
    sum([1, 2, 3, 4], 10)  [rule sum]
      sum([2, 3, 4], 9)  [rule sum]
        sum([3, 4], 7)  [rule sum]
          sum([4], 4)  [rule sum]
            sum([], 0)  [fact]
            4 = 4 + 0  [calculation]
          7 = 3 + 4  [calculation]
        9 = 2 + 7  [calculation]
      10 = 1 + 9  [calculation]
  TRUE

ask reverse([1, 2, 3], r)
  r = [3, 2, 1]
    reverse([1, 2, 3], [3, 2, 1])  [rule reverse]
      reverse_into([1, 2, 3], [], [3, 2, 1])  [rule reverse_into]
        reverse_into([2, 3], [1], [3, 2, 1])  [rule reverse_into]
          reverse_into([3], [2, 1], [3, 2, 1])  [rule reverse_into]
            reverse_into([], [3, 2, 1], [3, 2, 1])  [fact]
  TRUE

ask max_of([3, 9, 2], m)
  m = 9
    max_of([3, 9, 2], 9)  [rule max_of, clause 2]
      max_of([9, 2], 9)  [rule max_of, clause 1]
        max_of([2], 2)  [fact]
        9 >= 2  [comparison]
        9 = 9  [match]
      3 < 9  [comparison]
      9 = 9  [match]
  TRUE

ask sort([3, 1, 2, 5, 4], s)
  s = [1, 2, 3, 4, 5]
    sort([3, 1, 2, 5, 4], [1, 2, 3, 4, 5])  [rule sort]
      sort([1, 2, 5, 4], [1, 2, 4, 5])  [rule sort]
        sort([2, 5, 4], [2, 4, 5])  [rule sort]
          sort([5, 4], [4, 5])  [rule sort]
            sort([4], [4])  [rule sort]
              sort([], [])  [fact]
              insert(4, [], [4])  [fact]
            insert(5, [4], [4, 5])  [rule insert, clause 2]
              5 > 4  [comparison]
              insert(5, [], [5])  [fact]
          insert(2, [4, 5], [2, 4, 5])  [rule insert, clause 1]
            2 <= 4  [comparison]
        insert(1, [2, 4, 5], [1, 2, 4, 5])  [rule insert, clause 1]
          1 <= 2  [comparison]
      insert(3, [1, 2, 4, 5], [1, 2, 3, 4, 5])  [rule insert, clause 2]
        3 > 1  [comparison]
        insert(3, [2, 4, 5], [2, 3, 4, 5])  [rule insert, clause 2]
          3 > 2  [comparison]
          insert(3, [4, 5], [3, 4, 5])  [rule insert, clause 1]
            3 <= 4  [comparison]
  TRUE

